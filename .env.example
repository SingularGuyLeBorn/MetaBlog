# ============================================
# MetaBlog 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# --------------------------------------------
# 飞书/Lark Open API
# --------------------------------------------
# App ID 和 App Secret：从飞书开放平台获取
# https://open.feishu.cn/app
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 兼容旧变量名（二选一即可）
# LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
# LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# User Access Token：Wiki 操作必需
# 获取方式：飞书开放平台 → API 调试台 → 获取 Token
FEISHU_USER_ACCESS_TOKEN=u-xxxxxxxxxxxxxxxx

# --------------------------------------------
# 语雀 API（可选）
# --------------------------------------------
YUQUE_SESSION=your_yuque_session_cookie
YUQUE_CTOKEN=your_yuque_ctoken

# --------------------------------------------
# LLM 大模型配置（支持 LLM_ 或 VITE_ 前缀）
# --------------------------------------------
# 默认使用的 Provider
LLM_DEFAULT_PROVIDER=deepseek

# 每日预算（美元）
LLM_DAILY_BUDGET=10

# DeepSeek
LLM_DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_DEEPSEEK_MODEL=deepseek-chat
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI
# LLM_OPENAI_API_KEY=your-openai-api-key
# LLM_OPENAI_MODEL=gpt-4o
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
# LLM_ANTHROPIC_API_KEY=your-anthropic-api-key
# LLM_ANTHROPIC_MODEL=claude-3-5-sonnet
# LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
# LLM_GEMINI_API_KEY=your-gemini-api-key
# LLM_GEMINI_MODEL=gemini-1.5-pro
# LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1

# Zhipu (智谱)
# LLM_ZHIPU_API_KEY=your-zhipu-api-key
# LLM_ZHIPU_MODEL=glm-4
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Qwen (通义千问)
# LLM_QWEN_API_KEY=your-qwen-api-key
# LLM_QWEN_MODEL=qwen-plus
# LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Kimi (Moonshot)
# LLM_KIMI_API_KEY=your-kimi-api-key
# LLM_KIMI_MODEL=kimi-k2.5
# LLM_KIMI_BASE_URL=https://api.moonshot.cn/v1

# --------------------------------------------
# MetaAgent CLI
# --------------------------------------------
API_BASE=http://localhost:5173
