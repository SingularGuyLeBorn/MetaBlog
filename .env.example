# --------------------------------------------
# 本地语音服务(Piper TTS + Whisper ASR)
# --------------------------------------------
# Piper TTS(文本转语�? �?完全离线,零费�?# 下载地址: https://github.com/rhasspy/piper/releases
# 中文模型: https://huggingface.co/rhasspy/piper-voices/tree/v1.0.0/zh/zh_CN/huayan/medium
PIPER_PATH=vendor/piper/piper.exe
PIPER_MODEL_PATH=vendor/piper/zh_CN-huayan-medium.onnx
# PIPER_CONFIG_PATH=vendor/piper/zh_CN-huayan-medium.onnx.json

# Whisper ASR(语音转文�? �?完全离线,零费�?# 下载 whisper.cpp: https://github.com/ggml-org/whisper.cpp/releases (�?ggerganov 已迁�?
# Windows 下载 whisper-bin-x64.zip，解压取 whisper-cli.exe
# 下载模型 ggml-tiny.bin: https://huggingface.co/ggerganov/whisper.cpp/blob/main/ggml-tiny.bin
WHISPER_CLI_PATH=vendor/whisper/whisper-cli.exe
WHISPER_FALLBACK_PATH=vendor/whisper/main.exe
WHISPER_MODEL_PATH=vendor/whisper/ggml-tiny.bin

# --------------------------------------------
# MetaAgent CLI
# --------------------------------------------
API_BASE=http://localhost:5173
