    "# =============================================================================\n",
    "# 辅助函数：创建文档 + 读取验证\n",
    "# =============================================================================\n",
    "\n",
    "def test_format(name, lake_body, expected_texts):\n",
    "    \"\"\"\n",
    "    测试一种 Lake HTML 格式。\n",
    "    \n",
    "    参数:\n",
    "        name: 测试名称\n",
    "        lake_body: Lake HTML body 内容\n",
    "        expected_texts: 读取后应该包含的文本列表\n",
    "    \n",
    "    返回:\n",
    "        (doc_id, doc_slug) 如果成功\n",
    "    \"\"\"\n",
    "    print(f'\\n{"="*60}')\n",
    "    print(f'[测试] {name}')\n",
    "    print(f'{"="*60}')\n",
    "    \n",
    "    # 创建\n",
    "    payload = {\n",
    "        'book_id': BOOK_ID,\n",
    "        'title': f'[格式测试]{name}-{datetime.now().strftime(\"%H%M%S\")}',\n",
    "        'body': lake_body,\n",
    "        'format': 'lake',\n",
    "        'public': 0,\n",
    "    }\n",
    "    r = api('POST', '/api/docs', data=payload, referer=f'{BASE}/{BOOK_ID}')\n",
    "    \n",
    "    if 'data' not in r:\n",
    "        print(f'❌ 创建失败: {json.dumps(r, ensure_ascii=False, indent=2)[:500]}')\n",
    "        return None, None\n",
    "    \n",
    "    doc_id = r['data']['id']\n",
    "    doc_slug = r['data']['slug']\n",
    "    TEST_DOCS_TO_CLEANUP.append(doc_id)\n",
    "    print(f'✅ 创建成功: ID={doc_id}, Slug={doc_slug}')\n",
    "    \n",
    "    # 读取验证\n",
    "    r2 = api('GET', f'/api/docs/{doc_slug}', query={'book_id': str(BOOK_ID)})\n",
    "    content = r2.get('data', {}).get('content', '')\n",
    "    \n",
    "    all_pass = True\n",
    "    for expected in expected_texts:\n",
    "        passed = expected in content\n",
    "        status = '✅' if passed else '❌'\n",
    "        print(f'   {status} 包含 \"{expected[:50]}\"')\n",
    "        if not passed:\n",
    "            all_pass = False\n",
    "    \n",
    "    if not all_pass:\n",
    "        print(f'\\n📋 实际内容（前800字符）:')\n",
    "        print(content[:800])\n",
    "    \n",
    "    print(f'\\n{"✅ 通过" if all_pass else "❌ 失败"} — {name}')\n",
    "    return doc_id, doc_slug\n",
    "\n",
    "print('✅ 辅助函数定义完成')"
   ]
  },
