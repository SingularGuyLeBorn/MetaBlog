   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "# 1.1 创建：极简 Lake HTML\n",
    "# =============================================================================\n",
    "\n",
    "simple_body = '<!doctype lake><h1>极简测试</h1><p>这是一段普通文本。</p>'\n",
    "\n",
    "create_payload = {\n",
    "    'book_id': BOOK_ID,\n",
    "    'title': f'[CRUD验证]极简测试-{datetime.now().strftime(\"%H%M%S\")}',\n",
    "    'body': simple_body,\n",
    "    'format': 'lake',\n",
    "    'public': 0,\n",
    "}\n",
    "\n",
    "r = api('POST', '/api/docs', data=create_payload, referer=f'{BASE}/{BOOK_ID}')\n",
    "\n",
    "if 'data' not in r:\n",
    "    print(f'❌ 创建失败: {json.dumps(r, ensure_ascii=False, indent=2)}')\n",
    "    raise RuntimeError('创建失败')\n",
    "\n",
    "simple_doc = r['data']\n",
    "SIMPLE_DOC_ID = simple_doc['id']\n",
    "SIMPLE_DOC_SLUG = simple_doc['slug']\n",
    "TEST_DOCS_TO_CLEANUP.append(SIMPLE_DOC_ID)\n",
    "\n",
    "print(f'✅ 创建成功')\n",
    "print(f'   ID: {SIMPLE_DOC_ID}')\n",
    "print(f'   Slug: {SIMPLE_DOC_SLUG}')\n",
    "print(f'   标题: {simple_doc[\"title\"]}')"
   ]
